[Desktop Entry]
Type=Application
Name=Hermes (Leisten-Symbol)
Name[en]=Hermes (tray icon)
Comment=Startet das Hermes-Symbol in der Systemleiste
Comment[en]=Starts the Hermes icon in the system tray
Exec=/usr/libexec/hermes-os-tray
Icon=hermes-os
NoDisplay=true
Terminal=false
X-KDE-autostart-phase=2
OnlyShowIn=KDE;
