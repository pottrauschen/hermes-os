def load_plugin_module(name, path):
    import importlib.util
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise ImportError(f"{path} nicht ladbar")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def load_library_module():
    return load_plugin_module("hermes_os_library", LIBRARY_PY)


try:
    lib = load_library_module()
except Exception as exc:  # Fenster läuft ohne Bibliothek weiter, --check meldet es
    lib = None
    _LIBRARY_IMPORT_ERROR = str(exc)

