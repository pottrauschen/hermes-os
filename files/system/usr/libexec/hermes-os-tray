def now_hhmm():
    return datetime.datetime.now().strftime("%H:%M")


def format_time(stamp):
    """Zeitstempel des API-Servers (Epoche in Sekunden oder ISO-Text) als HH:MM,
    mit Datum, wenn nicht von heute; leer, wenn unlesbar."""
    try:
        if isinstance(stamp, (int, float)) and not isinstance(stamp, bool):
            when = datetime.datetime.fromtimestamp(float(stamp))
        elif isinstance(stamp, str) and stamp.strip():
            when = datetime.datetime.fromisoformat(stamp.strip().replace("Z", "+00:00"))
            if when.tzinfo is not None:
                when = when.astimezone().replace(tzinfo=None)
        else:
            return ""
    except (ValueError, OverflowError, OSError):
        return ""
    if when.date() == datetime.date.today():
        return when.strftime("%H:%M")
    return when.strftime("%d.%m. %H:%M")


def local_path(value):
    """Pfad aus QUrl, file:-Text oder Pfad-Text; None für alles andere (http, leer)."""
    from PySide6.QtCore import QUrl
    if isinstance(value, QUrl):
        return value.toLocalFile() if value.isLocalFile() else None
    text = str(value or "").strip()
    if not text:
        return None
    if text.startswith("file:"):
        return QUrl(text).toLocalFile() or None
    if "://" in text:
        return None
    return os.path.expanduser(text)


def file_url(path):
    from PySide6.QtCore import QUrl
    return QUrl.fromLocalFile(os.path.abspath(path)).toString()


def store_data_url(url):
    """data:image-URL aus dem Verlauf als Datei im Cache ablegen. Der Name kommt
    aus dem Inhalt, dasselbe Bild landet also nur einmal. Pfad oder None."""
    try:
        suffix, data = hc.decode_data_url(url)
    except ValueError:
        return None
    if len(data) > 20 * 1024 * 1024:
        return None
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        path = os.path.join(CACHE_DIR, "verlauf-" + hashlib.sha1(data).hexdigest()[:20] + suffix)
        if not os.path.isfile(path):
            part = path + ".part"
            with open(part, "wb") as f:
                f.write(data)
            os.replace(part, path)
        return path
    except OSError:
        return None


def prune_cache(days=CACHE_KEEP_DAYS):
    """Alte Bilder im Cache löschen; Verlaufsbilder entstehen bei Bedarf neu."""
    cutoff = time.time() - days * 86400
    try:
        with os.scandir(CACHE_DIR) as entries:
            for entry in entries:
                try:
                    if entry.is_file() and entry.stat().st_mtime < cutoff:
                        os.unlink(entry.path)
                except OSError:
                    pass
    except OSError:
        pass


def make_preview(path):
    """Für die Anzeige: ein Bild über IMAGE_MAX_EDGE als verkleinerte Kopie im
    Cache, damit der Verlauf keine 12-Megapixel-Fotos im Speicher hält (QML
    lädt in voller Größe). Kleine Bilder bleiben, wie sie sind; bei Fehlern
    kommt der Originalpfad zurück. Läuft auch im Arbeitsthread."""
    from PySide6.QtCore import Qt
    from PySide6.QtGui import QImage, QImageReader
    try:
        size = QImageReader(path).size()      # liest nur den Kopf der Datei
        if not size.isValid() or max(size.width(), size.height()) <= IMAGE_MAX_EDGE:
            return path
        stamp = f"{os.path.abspath(path)}|{os.path.getmtime(path)}|{os.path.getsize(path)}"
        png = path.lower().endswith(".png")
        target = os.path.join(CACHE_DIR, "vorschau-" + hashlib.sha1(stamp.encode("utf-8")).hexdigest()[:20]
                              + (".png" if png else ".jpg"))
        if os.path.isfile(target):
            return target
        image = QImage(path)
        if image.isNull():
            return path
        image = image.scaled(IMAGE_MAX_EDGE, IMAGE_MAX_EDGE, Qt.AspectRatioMode.KeepAspectRatio,
                             Qt.TransformationMode.SmoothTransformation)
        os.makedirs(CACHE_DIR, exist_ok=True)
        part = target + ".part"
        if image.save(part, "PNG" if png else "JPEG", 90):
            os.replace(part, target)
            return target
    except OSError:
        pass
    return path


def encode_image_for_upload(path):
    """Bild laden, auf IMAGE_MAX_EDGE verkleinern und als data-URL kodieren: PNG,
    wenn es Transparenz hat, sonst JPEG; wird es größer als IMAGE_MAX_BYTES,
    stärker komprimieren. Läuft im Arbeitsthread, QImage braucht keine GUI."""
    from PySide6.QtCore import QBuffer, QIODevice, Qt
    from PySide6.QtGui import QImage
    image = QImage(path)
    if image.isNull():
        raise ValueError(f"Kein lesbares Bild: {os.path.basename(path)}")
    if max(image.width(), image.height()) > IMAGE_MAX_EDGE:
        image = image.scaled(IMAGE_MAX_EDGE, IMAGE_MAX_EDGE, Qt.AspectRatioMode.KeepAspectRatio,
                             Qt.TransformationMode.SmoothTransformation)

    def encode(fmt, quality):
        buf = QBuffer()
        buf.open(QIODevice.OpenModeFlag.WriteOnly)
        image.save(buf, fmt, quality)
        buf.close()
        return bytes(buf.data())

    attempts = [("PNG", -1, "image/png")] if image.hasAlphaChannel() else []
    attempts += [("JPEG", 88, "image/jpeg"), ("JPEG", 70, "image/jpeg"), ("JPEG", 50, "image/jpeg")]
    for fmt, quality, mime in attempts:
        data = encode(fmt, quality)
        if 0 < len(data) <= IMAGE_MAX_BYTES:
            return f"data:{mime};base64," + base64.b64encode(data).decode("ascii")
    raise ValueError(f"Bild auch verkleinert zu groß: {os.path.basename(path)}")


def approval_timeout_seconds():
    """approvals.timeout aus config.yaml (Vorgabe 300), für die Benachrichtigung."""
    try:
        import yaml  # type: ignore
        cfg = yaml.safe_load(open(os.path.join(hc.hermes_home(), "config.yaml"), encoding="utf-8")) or {}
        return int((cfg.get("approvals") or {}).get("timeout") or 300)
    except Exception:
        return 300


def check_only():
    """Trockenlauf ohne Fenster: Importe, Dateien, Client-Selbsttest."""
    problems = []
    try:
        import PySide6.QtGui  # noqa: F401  (QImage fürs Verkleinern, QClipboard fürs Einfügen)
        import PySide6.QtQml  # noqa: F401
        import PySide6.QtQuickControls2  # noqa: F401
        import PySide6.QtWidgets  # noqa: F401
        import PySide6.QtNetwork  # noqa: F401
    except Exception as e:
        problems.append(f"PySide6 fehlt: {e}")
    if not os.path.isfile(MAIN_QML):
        problems.append(f"{MAIN_QML} fehlt")
    if hc is None:
        problems.append(f"hermes_client.py nicht importierbar: {_CLIENT_IMPORT_ERROR}")
    if mc is None:
        problems.append(f"model_choice.py nicht importierbar: {_CHOICE_IMPORT_ERROR}")
    else:
        problems.extend(f"hermes_client: {p}" for p in hc.self_test())
    if lib is None:
        problems.append(f"library.py des Plugins nicht ladbar: {_LIBRARY_IMPORT_ERROR}")
    if audit is None:
        problems.append(f"audit.py des Plugins nicht ladbar: {_AUDIT_IMPORT_ERROR}")
    try:
        import runner  # noqa: F401  (KRunner-Runner samt dbus_peer)
    except Exception as e:
        problems.append(f"runner.py nicht importierbar: {e}")
    try:
        import desktop, screenshot, voice  # noqa: F401  (Sehen und Hören, docs/sehen-hoeren.md)
        problems.extend(f"desktop: {p}" for p in desktop.self_test())
    except Exception as e:
        problems.append(f"desktop.py, screenshot.py oder voice.py nicht importierbar: {e}")
    if shutil.which("notify-send") is None:
        print("WARN  notify-send fehlt: Freigaben nur im Fenster, keine Benachrichtigung")
    if shutil.which("spectacle") is None:
        print("WARN  spectacle fehlt: „Was sehe ich hier?“ hat keinen Auswahlrahmen")
    if shutil.which("pw-record") is None and shutil.which("parecord") is None:
        print("WARN  weder pw-record noch parecord: Push-to-Talk hat kein Aufnahmeprogramm")
    for p in problems:
        print(f"FEHL  {p}")
    if problems:
        return 1
    print("OK    hermes-os-tray: PySide6, QML und Client vorhanden")
    return 0


def tool_duration(seconds):
    """Dauer eines Werkzeugaufrufs für die Zeile im Verlauf: „0,3 s“, ab einer Minute
    „1 min 5 s“; ohne Angabe „fertig“."""
    try:
        s = float(seconds)
    except (TypeError, ValueError):
        return "fertig"
    if s >= 60:
        return f"{int(s // 60)} min {int(round(s % 60))} s"
    return f"{s:.1f} s".replace(".", ",")


def main():
    if "--check" in sys.argv:
        sys.exit(check_only())
    want_show = "--show" in sys.argv
    discuss_path = ""
    if "--discuss" in sys.argv:
        i = sys.argv.index("--discuss")
        discuss_path = os.path.abspath(sys.argv[i + 1]) if i + 1 < len(sys.argv) else ""
        want_show = True
    want_look, look_question = "--look" in sys.argv, ""
    if want_look:
        i = sys.argv.index("--look")
        look_question = " ".join(a for a in sys.argv[i + 1:] if not a.startswith("--"))
    want_talk = "--talk" in sys.argv

    from PySide6.QtCore import (QAbstractListModel, QFileSystemWatcher, QModelIndex, QObject, QProcess,
                                QStandardPaths, QTimer, Qt, QByteArray, QUrl, Property, Signal, Slot)
    from PySide6.QtGui import QDesktopServices, QIcon
    from PySide6.QtNetwork import QLocalServer, QLocalSocket
    from PySide6.QtQml import QQmlApplicationEngine
    from PySide6.QtQuickControls2 import QQuickStyle
    from PySide6.QtWidgets import QApplication, QFileDialog, QMenu, QSystemTrayIcon

    # ---- Nur eine Instanz: die zweite reicht "show" an die erste weiter --------
    socket_name = f"hermes-os-tray-{os.getuid()}"
    probe = QLocalSocket()
    probe.connectToServer(socket_name)
    if probe.waitForConnected(300):
        if discuss_path:
            probe.write(b"discuss " + os.fsencode(discuss_path) + b"\n")
            probe.waitForBytesWritten(300)
        elif want_look:
            probe.write(b"look " + look_question.encode("utf-8") + b"\n")
            probe.waitForBytesWritten(300)
        elif want_talk:
            probe.write(b"talk\n")
            probe.waitForBytesWritten(300)
        elif want_show:
            probe.write(b"show\n")
            probe.waitForBytesWritten(300)
        probe.disconnectFromServer()
        return 0
    QLocalServer.removeServer(socket_name)

    class MessageModel(QAbstractListModel):
        """Verlauf für die QML-Liste: role (user, assistant, tool, info, error), text, meta,
        images (Liste von URLs, file: oder http) und time (HH:MM oder leer)."""
        _USER = int(Qt.ItemDataRole.UserRole)
        RoleRole, TextRole, MetaRole, ImagesRole, TimeRole = _USER + 1, _USER + 2, _USER + 3, _USER + 4, _USER + 5

        def __init__(self):
            super().__init__()
            self._rows = []

        @staticmethod
        def _row(role, text, meta="", images=None, when=""):
            return {"role": role, "text": text, "meta": meta or "", "images": list(images or []), "time": when or ""}

        def rowCount(self, parent=QModelIndex()):
            return 0 if parent.isValid() else len(self._rows)

        def data(self, index, role=int(Qt.ItemDataRole.DisplayRole)):
            if not index.isValid() or index.row() >= len(self._rows):
                return None
            row = self._rows[index.row()]
            return {self.RoleRole: row["role"], self.TextRole: row["text"], self.MetaRole: row["meta"],
                    self.ImagesRole: list(row["images"]), self.TimeRole: row["time"],
                    int(Qt.ItemDataRole.DisplayRole): row["text"]}.get(int(role))

        def roleNames(self):
            return {self.RoleRole: QByteArray(b"role"), self.TextRole: QByteArray(b"text"),
                    self.MetaRole: QByteArray(b"meta"), self.ImagesRole: QByteArray(b"images"),
                    self.TimeRole: QByteArray(b"time")}

        def append(self, role, text, meta="", images=None, when=""):
            n = len(self._rows)
            self.beginInsertRows(QModelIndex(), n, n)
            self._rows.append(self._row(role, text, meta, images, when))
            self.endInsertRows()
            return n

        def set_text(self, row, text, meta=None):
            if 0 <= row < len(self._rows):
                self._rows[row]["text"] = text
                if meta is not None:
                    self._rows[row]["meta"] = meta
                idx = self.index(row, 0)
                self.dataChanged.emit(idx, idx, [self.TextRole, self.MetaRole])

        def set_images(self, row, images):
            if 0 <= row < len(self._rows):
                self._rows[row]["images"] = list(images or [])
                idx = self.index(row, 0)
                self.dataChanged.emit(idx, idx, [self.ImagesRole])

        def text(self, row):
            return self._rows[row]["text"] if 0 <= row < len(self._rows) else ""

        def remove(self, row):
            if 0 <= row < len(self._rows):
                self.beginRemoveRows(QModelIndex(), row, row)
                del self._rows[row]
                self.endRemoveRows()

        def replace(self, rows):
            self.beginResetModel()
            self._rows = [self._row(r["role"], r["text"], r.get("meta", ""), r.get("images"), r.get("time", ""))
                          for r in rows]
            self.endResetModel()

        def clear(self):
            self.replace([])

    class AuditModel(QAbstractListModel):
        """Zeilen des Protokolls für die QML-Liste, Felder wie audit.build_rows:
        rowId, date, time, kind (command, app), command, groupLabel, decisionLabel,
        decider, status (ok, error, denied, pending, approved, launched, failed),
        resultText, output, changed."""
        FIELDS = ("rowId", "date", "time", "kind", "command", "groupLabel", "decisionLabel", "decider",
                  "status", "resultText", "output", "changed")
        _USER = int(Qt.ItemDataRole.UserRole)

        def __init__(self):
            super().__init__()
            self._rows = []

        def rowCount(self, parent=QModelIndex()):
            return 0 if parent.isValid() else len(self._rows)

        def data(self, index, role=int(Qt.ItemDataRole.DisplayRole)):
            if not index.isValid() or index.row() >= len(self._rows):
                return None
            role = int(role)
            if role == int(Qt.ItemDataRole.DisplayRole):
                role = self._USER + 1 + self.FIELDS.index("command")
            i = role - self._USER - 1
            if 0 <= i < len(self.FIELDS):
                return self._rows[index.row()][self.FIELDS[i]]
            return None

        def roleNames(self):
            return {self._USER + 1 + i: QByteArray(f.encode("ascii")) for i, f in enumerate(self.FIELDS)}

        def replace(self, rows):
            self.beginResetModel()
            self._rows = [{**{f: r.get(f, "") for f in self.FIELDS}, "rowId": r.get("id", ""),
                           "changed": bool(r.get("changed"))} for r in rows]
            self.endResetModel()

    class Backend(QObject):
        stateChanged = Signal()
        approvalChanged = Signal()
        busyChanged = Signal()
        versionChanged = Signal()
        showRequested = Signal()
        hideRequested = Signal()
        attachmentsChanged = Signal()
        libraryChanged = Signal()
        showLibraryRequested = Signal()
        libraryMirrorChanged = Signal()     # Stand der Spiegel je Eintrag
        librarySearchChanged = Signal()     # Treffer der Suche auf der Seite
        libraryMcpChanged = Signal()        # Schalter der Doku-Server
        auditChanged = Signal()
        showAuditRequested = Signal()
        modelChanged = Signal()             # Modell, Denkaufwand oder die Modell-Liste
        answerFinished = Signal(str)    # Antworttext eines Runs aus dem Fenster, leer bei Abbruch (voice.py liest vor)
        # Ergebnisse aus Arbeitsthreads, immer über die Ereignisschleife
        _healthDone = Signal(dict)
        _historyDone = Signal(dict)
        _runEvent = Signal(str, dict)
        _modelsDone = Signal(list)
        _mirrorEvent = Signal(str, dict)
        _searchDone = Signal(str, list, str)

        def __init__(self):
            super().__init__()
            self._state = "off"
            self._busy = False
            self._approval = {}
            self._version = ""
            self._attachments = []      # {"path", "url", "name"} je Bild für die nächste Nachricht
            self._library = lib.load_entries() if lib is not None else []
            self._mirrors = {}              # Kennung -> Stand (docs/bibliothek.md, Stufe zwei)
            self._mirror_jobs = {}          # Kennung -> threading.Event zum Abbrechen
            self._remove_after_mirror = set()   # Entfernen gewünscht, während der Spiegel lief
            self._search_query = ""
            self._search_hits = []
            self._search_note = ""
            self._searching = False
            self._mcp = []
            self._mcp_message = ""
            prune_cache()
            self._model = MessageModel()
            self._audit_model = AuditModel()
            self._audit_rows = []           # gefiltert, wie auf der Seite
            self._audit_period = "today"
            self._audit_changes_only = False
            self._audit_active = False      # Seite offen: nur dann liest der Watcher neu
            self._audit_dirty = True
            self._audit_timer = QTimer(self)
            self._audit_timer.setSingleShot(True)
            self._audit_timer.setInterval(AUDIT_DEBOUNCE_MS)
            self._audit_timer.timeout.connect(self._audit_changed_on_disk)
            self._audit_watcher = QFileSystemWatcher(self)
            self._audit_watcher.fileChanged.connect(lambda _p: self._audit_timer.start())
            self._audit_watcher.directoryChanged.connect(lambda _p: self._audit_timer.start())
            self._audit_watch()
            self._settings = hc.gateway_settings()
            self._client = self._make_client()
            self._session_id = self._load_session_id()
            self._session_ready = False
            self._history_loaded = False
            self._run_id = ""
            self._assistant_row = -1
            self._open_tools = []       # (Werkzeug, Zeile) der laufenden Aufrufe, für tool.completed
            self._poll_busy = False
            self._notify_proc = None
            self._context = ""          # Kontext aus einer Benachrichtigung für die nächste Nachricht
            self._choice = mc.read_choice() if mc else {"model": "", "provider": "", "base_url": "", "effort": ""}
            self._model_options = []    # nur für Endpunkte auf diesem Rechner (model_choice.py)
            queued = Qt.ConnectionType.QueuedConnection
            self._modelsDone.connect(self._on_models, queued)
            self._healthDone.connect(self._on_health, queued)
            self._historyDone.connect(self._on_history, queued)
            self._runEvent.connect(self._on_run_event, queued)
            self._mirrorEvent.connect(self._on_mirror_event, queued)
            self._searchDone.connect(self._on_search_done, queued)
            self._timer = QTimer(self)
            self._timer.setInterval(HEALTH_INTERVAL_MS)
            self._timer.timeout.connect(self.poll)
            self._timer.start()
            QTimer.singleShot(0, self.poll)

        # ---- Einstellungen und Sitzung ---------------------------------------
        def _make_client(self):
            s = self._settings
            return hc.GatewayClient(s["host"], s["port"], s["key"])

        def _load_session_id(self):
            try:
                with open(SESSION_FILE, encoding="utf-8") as f:
                    sid = str(json.load(f).get("session_id") or "")
                    return sid or DEFAULT_SESSION
            except Exception:
                return DEFAULT_SESSION

        def _save_session_id(self):
            try:
                os.makedirs(os.path.dirname(SESSION_FILE), exist_ok=True)
                with open(SESSION_FILE, "w", encoding="utf-8") as f:
                    json.dump({"session_id": self._session_id}, f)
            except OSError:
                pass

        # ---- Eigenschaften für QML ---------------------------------------------
        @Property(str, notify=stateChanged)
        def state(self):
            return self._state

        @Property(str, notify=stateChanged)
        def stateText(self):
            return STATE_TEXT.get(self._state, self._state)

        @Property(str, notify=stateChanged)
        def stateIcon(self):
            return STATE_ICON.get(self._state, "hermes-os-tray-off")

        @Property(bool, notify=busyChanged)
        def busy(self):
            return self._busy

        @Property(bool, notify=approvalChanged)
        def approvalPending(self):
            return bool(self._approval)

        @Property("QVariantMap", notify=approvalChanged)
        def approval(self):
            return dict(self._approval)

        @Property(QObject, constant=True)
        def messages(self):
            return self._model

        @Property(str, notify=versionChanged)
        def hermesVersion(self):
            return self._version

        @Property(bool, constant=True)
        def dashboardAvailable(self):
            return os.access(DASHBOARD, os.X_OK)

        @Property(bool, notify=stateChanged)
        def configured(self):
            """Ein Anbieter ist eingerichtet, sobald .env oder auth.json existiert (wie First-Login)."""
            home = hc.hermes_home()
            return os.path.isfile(os.path.join(home, ".env")) or os.path.isfile(os.path.join(home, "auth.json"))

        @Property(str, notify=stateChanged)
        def sessionId(self):
            return self._session_id

        # ---- Modell und Denkaufwand (model_choice.py) ------------------------------
        @Property(bool, notify=modelChanged)
        def modelAvailable(self):
            return mc is not None and bool(self._choice["model"])

        @Property(str, notify=modelChanged)
        def modelText(self):
            return mc.button_text(self._choice, self._model_options) if mc else ""

        @Property(bool, notify=modelChanged)
        def modelSwitchable(self):
            """Eine Liste zum Wählen gibt es nur für Endpunkte auf diesem Rechner."""
            return mc is not None and mc.is_local(self._choice) and len(self._model_options) > 0

        @Property("QVariantList", notify=modelChanged)
        def modelOptions(self):
            return [dict(o, checked=o["id"] == self._choice["model"]) for o in self._model_options]

        @Property("QVariantList", notify=modelChanged)
        def effortOptions(self):
            if mc is None:
                return []
            return [{"value": v, "label": label, "checked": v == self._choice["effort"]} for v, label in mc.EFFORTS]

        def _reload_choice(self):
            if mc is None:
                return
            new = mc.read_choice()
            if new == self._choice:
                return
            moved = (new["provider"], new["base_url"]) != (self._choice["provider"], self._choice["base_url"])
            self._choice = new
            self.modelChanged.emit()
            if moved:
                self.refreshModels()

        @Slot()
        def refreshModels(self):
            """Liste des Endpunkts neu holen, im Hintergrund; Cloud-Anbieter haben keine."""
            if mc is None:
                return
            choice = dict(self._choice)
            if not mc.is_local(choice):
                if self._model_options:
                    self._model_options = []
                    self.modelChanged.emit()
                return

            def work():
                try:
                    options = mc.fetch_models(choice["base_url"])
                except Exception:
                    options = []
                self._modelsDone.emit(options)

            threading.Thread(target=work, name="hermes-models", daemon=True).start()

        def _on_models(self, options):
            options = list(options or [])
            if options != self._model_options:
                self._model_options = options
                self.modelChanged.emit()

        @Slot(str)
        def setModel(self, model):
            if mc is None or not model or model == self._choice["model"]:
                return
            try:
                mc.write_model(model)
            except Exception as exc:
                self._model.append("error", f"Modell nicht umgestellt: {type(exc).__name__}: {exc}")
                return
            self._reload_choice()
            self._model.append("info", f"Modell für die nächsten Nachrichten: {mc.model_label(model, self._model_options)}",
                               when=now_hhmm())

        @Slot(str)
        def setEffort(self, effort):
            if mc is None or effort == self._choice["effort"]:
                return
            try:
                mc.write_effort(effort)
            except Exception as exc:
                self._model.append("error", f"Denkaufwand nicht umgestellt: {type(exc).__name__}: {exc}")
                return
            self._reload_choice()
            self._model.append("info", f"Denkaufwand für die nächsten Nachrichten: {mc.EFFORT_LABEL.get(effort, effort)}",
                               when=now_hhmm())

        # ---- Anhänge: Bilder für die nächste Nachricht ------------------------------
        @Property("QVariantList", notify=attachmentsChanged)
        def attachments(self):
            return [dict(a) for a in self._attachments]

        @Property(int, notify=attachmentsChanged)
        def attachmentCount(self):
            return len(self._attachments)

        def _add_attachment(self, path):
            path = os.path.abspath(path)
            if not os.path.isfile(path) or not path.lower().endswith(hc.IMAGE_SUFFIXES):
                return False
            if any(a["path"] == path for a in self._attachments):
                return True
            if len(self._attachments) >= IMAGE_MAX_COUNT:
                self._model.append("info", f"Höchstens {IMAGE_MAX_COUNT} Bilder je Nachricht.")
                return False
            # path geht später verkleinert zum Gateway, url zeigt die Vorschau im Fenster
            self._attachments.append({"path": path, "url": file_url(make_preview(path)),
                                      "name": os.path.basename(path)})
            return True

        @Slot(list)
        def attachFiles(self, urls):
            """Bilder anhängen: aus dem Dialog, der Zwischenablage oder ins Fenster gezogen.
            Nimmt QUrl, file:-Text oder Pfade; alles andere als Bilddateien wird übergangen."""
            before = len(self._attachments)
            for value in urls or []:
                path = local_path(value)
                if path:
                    self._add_attachment(path)
            if len(self._attachments) != before:
                self.attachmentsChanged.emit()

        @Slot()
        def attachFromDialog(self):
            start = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.PicturesLocation) \
                or os.path.expanduser("~")
            files, _ = QFileDialog.getOpenFileNames(None, "Bild anhängen", start,
                                                    "Bilder (*.png *.jpg *.jpeg *.gif *.webp *.bmp);;Alle Dateien (*)")
            if files:
                self.attachFiles(list(files))

        @Slot(result=bool)
        def pasteImage(self):
            """Strg+V im Textfeld: liegt ein Bild in der Zwischenablage, wird es angehängt
            (als PNG im Cache); liegen Bilddateien darin, ebenso. Sonst False, und das
            Textfeld fügt wie gewohnt Text ein."""
            clipboard = QApplication.clipboard()
            image = clipboard.image()
            if not image.isNull():
                try:
                    os.makedirs(CACHE_DIR, exist_ok=True)
                    path = os.path.join(CACHE_DIR, "ablage-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f") + ".png")
                    if image.save(path, "PNG"):
                        self.attachFiles([path])
                        return True
                except OSError:
                    pass
                return False
            mime = clipboard.mimeData()
            if mime is not None and mime.hasUrls():
                paths = [u.toLocalFile() for u in mime.urls() if u.isLocalFile()]
                paths = [p for p in paths if p.lower().endswith(hc.IMAGE_SUFFIXES)]
                if paths:
                    self.attachFiles(paths)
                    return True
            return False

        @Slot(int)
        def removeAttachment(self, index):
            if 0 <= index < len(self._attachments):
                del self._attachments[index]
                self.attachmentsChanged.emit()

        @Slot()
        def clearAttachments(self):
            if self._attachments:
                self._attachments = []
                self.attachmentsChanged.emit()

        @Slot(str)
        def openImage(self, url):
            """Bild im Bildbetrachter öffnen (Klick auf ein Bild im Verlauf)."""
            if url:
                QDesktopServices.openUrl(QUrl(url))

        # ---- Bibliothek: Wissensquellen für den Agenten (docs/bibliothek.md) ------
        @Property(bool, constant=True)
        def libraryAvailable(self):
            return lib is not None

        @Property("QVariantList", notify=libraryChanged)
        def library(self):
            return [dict(e) for e in self._library]

        @Property(int, notify=libraryChanged)
        def libraryCount(self):
            return len(self._library)

        @Slot()
        def libraryReload(self):
            """Datei neu lesen, etwa beim Öffnen der Seite; der Agent oder ein zweites
            Fenster könnten sie geändert haben. Dazu den Stand der Spiegel aus dem
            Index und die Schalter der Doku-Server aus config.yaml."""
            if lib is not None:
                self._library = lib.load_entries()
                try:
                    stored = lib.mirror_status_all()
                except Exception as exc:  # noqa: BLE001 — kaputter Index sperrt die Seite nicht
                    print(f"hermes-os-tray: Index nicht lesbar: {exc}", file=sys.stderr)
                    stored = {}
                for entry_id, status in stored.items():
                    if entry_id not in self._mirror_jobs:     # laufende Spiegel melden sich selbst
                        row = self._mirror_row(status)
                        if row["running"]:
                            # Läuft im Gateway (library_mirror) oder blieb nach einem Abbruch des
                            # Symbols stehen: hier gibt es nichts abzubrechen, Spiegeln bleibt möglich
                            row["running"] = False
                            row["text"] += " (nicht aus diesem Fenster gestartet)"
                        self._mirrors[entry_id] = row
                for entry_id in list(self._mirrors):
                    if entry_id not in stored and entry_id not in self._mirror_jobs:
                        del self._mirrors[entry_id]
                self._mcp = lib.mcp_catalog()
            self.libraryChanged.emit()
            self.libraryMirrorChanged.emit()
            self.libraryMcpChanged.emit()

        def _mirror_row(self, status):
            """Stand eines Spiegels, wie die Seite ihn zeigt."""
            row = {"status": status.get("status", ""), "pages": int(status.get("pages") or 0),
                   "running": status.get("status") == "running", "errorCount": int(status.get("error_count") or 0),
                   "current": str(status.get("current") or ""), "text": lib.describe_mirror(status)}
            if row["running"] and row["current"]:
                row["text"] += " " + row["current"]
            return row

        @Property("QVariantMap", notify=libraryMirrorChanged)
        def libraryMirror(self):
            return {k: dict(v) for k, v in self._mirrors.items()}

        @Property(bool, notify=libraryMirrorChanged)
        def libraryMirrorRunning(self):
            return bool(self._mirror_jobs)

        @Slot(str)
        def libraryMirrorStart(self, entry_id):
            """Spiegel im Arbeitsthread anlegen oder erneuern; der Fortschritt kommt
            über _mirrorEvent zurück in die Ereignisschleife."""
            if lib is None or entry_id in self._mirror_jobs:
                return
            entry = next((e for e in self._library if e["id"] == entry_id), None)
            if entry is None:
                return
            cancel = threading.Event()
            self._mirror_jobs[entry_id] = cancel
            self._mirrors[entry_id] = self._mirror_row({"status": "running", "pages": 0})
            self.libraryMirrorChanged.emit()

            def work():
                try:
                    lib.mirror_entry(entry, depth=lib.MIRROR_DEPTH, max_pages=lib.MIRROR_PAGES,
                                     progress=lambda st: self._mirrorEvent.emit(entry_id, dict(st)),
                                     cancel=cancel.is_set)
                except Exception as exc:  # noqa: BLE001 — der Fehler gehört auf die Seite
                    self._mirrorEvent.emit(entry_id, {"entry_id": entry_id, "status": "error", "pages": 0,
                                                      "error_count": 1, "errors": [str(exc)], "finished": time.time()})

            threading.Thread(target=work, name=f"hermes-mirror-{entry_id}", daemon=True).start()

        @Slot(str)
        def libraryMirrorCancel(self, entry_id):
            cancel = self._mirror_jobs.get(entry_id)
            if cancel is not None:
                cancel.set()

        def _on_mirror_event(self, entry_id, status):
            self._mirrors[entry_id] = self._mirror_row(status)
            if status.get("status") != "running":
                self._mirror_jobs.pop(entry_id, None)
                entry = next((e for e in self._library if e["id"] == entry_id), None)
                title = entry["title"] if entry else entry_id
                self._model.append("info", f"Bibliothek: {title}, {lib.describe_mirror(status)}")
                if entry_id in self._remove_after_mirror:
                    self._remove_after_mirror.discard(entry_id)
                    self._mirrors.pop(entry_id, None)
                    lib.remove_entry(entry_id)
                    self.libraryReload()
            self.libraryMirrorChanged.emit()

        @Property("QVariantList", notify=librarySearchChanged)
        def librarySearchHits(self):
            return [dict(h) for h in self._search_hits]

        @Property(str, notify=librarySearchChanged)
        def librarySearchNote(self):
            return self._search_note

        @Property(bool, notify=librarySearchChanged)
        def librarySearching(self):
            return self._searching

        @Slot(str)
        def librarySearch(self, query):
            """Volltextsuche im Index, im Arbeitsthread; leer räumt die Treffer weg."""
            query = (query or "").strip()
            self._search_query = query
            if not query or lib is None:
                self._search_hits, self._search_note, self._searching = [], "", False
                self.librarySearchChanged.emit()
                return
            self._searching = True
            self.librarySearchChanged.emit()
            has_mirror = bool(self._mirrors)     # im GUI-Thread lesen, nicht im Arbeitsthread

            def work():
                try:
                    if not has_mirror:
                        self._searchDone.emit(query, [], "Noch kein Spiegel: erst einen Eintrag spiegeln, dann suchen.")
                        return
                    hits, mode = lib.search_index(query, "", lib.SEARCH_LIMIT_MAX)
                    if not hits:
                        note = f"Keine Treffer für „{query}“."
                    else:
                        note = (f"{len(hits)} Treffer" if len(hits) > 1 else "1 Treffer") + f" für „{query}“"
                        note += " (LIKE-Suche, kein FTS5)." if mode == "like" else "."
                    self._searchDone.emit(query, hits, note)
                except Exception as exc:  # noqa: BLE001
                    self._searchDone.emit(query, [], f"Suche fehlgeschlagen: {exc}")

            threading.Thread(target=work, name="hermes-library-search", daemon=True).start()

        def _on_search_done(self, query, hits, note):
            if query != self._search_query:
                return      # eine neuere Suche läuft schon
            titles = {e["id"]: e["title"] for e in self._library}
            self._search_hits = [{"title": h.get("title") or h.get("source", ""), "source": h.get("source", ""),
                                  "entryId": h.get("entry_id", ""), "entryTitle": titles.get(h.get("entry_id"), h.get("entry_id", "")),
                                  "snippet": h.get("snippet", "")} for h in hits]
            self._search_note = note
            self._searching = False
            self.librarySearchChanged.emit()

        @Slot(str, str, str, result=str)
        def libraryUpdate(self, entry_id, title, note):
            """Titel und Notiz ändern; leerer Text heißt Erfolg, sonst der Fehler fürs Fenster."""
            if lib is None:
                return "Die Bibliothek ist nicht verfügbar (library.py fehlt)."
            _entry, err = lib.update_entry(entry_id, title=title, note=note)
            self.libraryReload()
            return err

        @Slot(list, str, result=str)
        def libraryDrop(self, urls, text):
            """Ins Fenster gezogen: Dateien und Ordner aus dem Dateimanager, Adressen aus
            dem Browser (als Adresse oder als Text). Liefert die Meldung für die Seite."""
            if lib is None:
                return "Die Bibliothek ist nicht verfügbar (library.py fehlt)."
            sources = []
            for value in urls or []:
                path = local_path(value)
                if path:
                    sources.append(path)
                    continue
                raw = value.toString() if isinstance(value, QUrl) else str(value or "")
                if lib.is_url(raw):
                    sources.append(raw.strip())
            if not sources:
                for line in (text or "").splitlines():
                    if lib.is_url(line):
                        sources.append(line.strip())
                        break
            if not sources:
                return "Nichts Verwertbares abgelegt: Dateien, Ordner oder eine http(s)-Adresse."
            added, errors = [], []
            for source in sources:
                entry, err = lib.add_entry(source)
                if err:
                    errors.append(err)
                else:
                    added.append(entry["title"])
            self.libraryReload()
            parts = []
            if added:
                parts.append(("Eingetragen: " if len(added) > 1 else "Eingetragen, gilt ab dem nächsten Gespräch: ") + ", ".join(added))
                self._model.append("info", "Bibliothek: " + ", ".join(added) + " eingetragen, gilt ab dem nächsten Gespräch.")
            parts += errors
            return " ".join(parts)

        @Slot(str)
        def libraryOpenSource(self, source):
            """Treffer der Suche im Browser oder Programm öffnen."""
            if not source:
                return
            QDesktopServices.openUrl(QUrl(source) if lib is not None and lib.is_url(source) else QUrl.fromLocalFile(source))

        @Property("QVariantList", notify=libraryMcpChanged)
        def libraryMcp(self):
            return [dict(item) for item in self._mcp]

        @Property(str, notify=libraryMcpChanged)
        def libraryMcpMessage(self):
            return self._mcp_message

        @Slot(str, bool, result=str)
        def libraryMcpSet(self, server_id, enabled):
            """Doku-Server in ~/.hermes/config.yaml ein- oder austragen. Das Gateway
            gleicht die Datei von selbst ab; ein Neustart ist nicht nötig."""
            if lib is None:
                return "Die Bibliothek ist nicht verfügbar (library.py fehlt)."
            _changed, message = lib.mcp_set(server_id, bool(enabled))
            self._mcp_message = message
            self._mcp = lib.mcp_catalog()
            self.libraryMcpChanged.emit()
            return message

        @Slot(str, str, str, result=str)
        def libraryAdd(self, source, title, note):
            """Eintrag anlegen; leerer Text heißt Erfolg, sonst der Fehler fürs Fenster."""
            if lib is None:
                return "Die Bibliothek ist nicht verfügbar (library.py fehlt)."
            entry, err = lib.add_entry(source, title, note)
            self.libraryReload()
            if err:
                return err
            self._model.append("info", f"Bibliothek: {entry['title']} eingetragen, gilt ab dem nächsten Gespräch.")
            return ""

        @Slot(str)
        def libraryRemove(self, entry_id):
            if lib is None:
                return
            if entry_id in self._mirror_jobs:
                # Läuft noch ein Spiegel: abbrechen, entfernen erst, wenn der
                # Arbeitsthread fertig ist, sonst schreibt er den Eintrag zurück.
                self._remove_after_mirror.add(entry_id)
                self._mirror_jobs[entry_id].set()
                return
            if lib.remove_entry(entry_id):
                self.libraryReload()

        @Slot(result=str)
        def libraryPickFile(self):
            start = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.DocumentsLocation) \
                or os.path.expanduser("~")
            path, _ = QFileDialog.getOpenFileName(None, "Datei für die Bibliothek", start,
                                                  "Texte und Dokumente (*.pdf *.md *.txt *.html *.htm *.rst *.csv *.json *.yaml *.yml);;Alle Dateien (*)")
            return path or ""

        @Slot(result=str)
        def libraryPickFolder(self):
            start = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.DocumentsLocation) \
                or os.path.expanduser("~")
            return QFileDialog.getExistingDirectory(None, "Ordner für die Bibliothek", start) or ""

        @Slot(str)
        def libraryOpen(self, entry_id):
            """Eintrag im Browser oder Dateimanager öffnen."""
            for e in self._library:
                if e["id"] == entry_id:
                    url = QUrl(e["source"]) if e["kind"] == "url" else QUrl.fromLocalFile(e["source"])
                    QDesktopServices.openUrl(url)
                    return

        @Slot()
        def showLibrary(self):
            """Aus dem Menü am Symbol: Fenster zeigen und die Seite öffnen."""
            self.showRequested.emit()
            self.showLibraryRequested.emit()

        # ---- Protokoll: was Hermes am System getan hat (docs/protokoll.md) -------
        def _audit_watch(self):
            """Ordner und Datei beobachten. Den Ordner, weil die Datei erst mit dem
            ersten Eintrag entsteht und bei der Rotation ersetzt wird; die Datei,
            weil ein Anhängen den Ordner nicht ändert."""
            if audit is None:
                return
            path = audit.audit_path()
            try:
                path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            except OSError:
                return
            watched = set(self._audit_watcher.files()) | set(self._audit_watcher.directories())
            for p in (str(path.parent), str(path)):
                if p not in watched and os.path.exists(p):
                    self._audit_watcher.addPath(p)

        def _audit_changed_on_disk(self):
            self._audit_watch()
            if self._audit_active:
                self.auditReload()
            else:
                self._audit_dirty = True

        @Property(bool, constant=True)
        def auditAvailable(self):
            return audit is not None

        @Property(QObject, constant=True)
        def auditModel(self):
            return self._audit_model

        @Property(int, notify=auditChanged)
        def auditCount(self):
            return len(self._audit_rows)

        @Property(str, notify=auditChanged)
        def auditPeriod(self):
            return self._audit_period

        @Property(bool, notify=auditChanged)
        def auditChangesOnly(self):
            return self._audit_changes_only

        @Property(str, constant=True)
        def auditPath(self):
            return str(audit.audit_path()) if audit is not None else ""

        @Slot(bool)
        def auditSetActive(self, active):
            """Die Seite meldet sich an und ab; geschlossen wird nicht neu gelesen."""
            self._audit_active = bool(active)
            if self._audit_active and self._audit_dirty:
                self.auditReload()

        @Slot()
        def auditReload(self):
            self._audit_dirty = False
            rows = audit.load_rows(self._audit_period, self._audit_changes_only) if audit is not None else []
            self._audit_rows = rows
            self._audit_model.replace(rows)
            self.auditChanged.emit()

        @Slot(str, bool)
        def auditSetFilter(self, period, changes_only):
            if audit is not None and period not in audit.PERIODS:
                period = "today"
            self._audit_period = period
            self._audit_changes_only = bool(changes_only)
            self.auditReload()

        @Slot(result=str)
        def auditExport(self):
            """Gezeigte Zeilen als Textdatei über den Dateidialog; leerer Text heißt
            abgebrochen, sonst eine Meldung fürs Fenster."""
            if audit is None:
                return "Das Protokoll ist nicht verfügbar (audit.py fehlt)."
            start = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.DocumentsLocation) \
                or os.path.expanduser("~")
            name = "hermes-protokoll-" + datetime.datetime.now().strftime("%Y-%m-%d") + ".txt"
            target, _ = QFileDialog.getSaveFileName(None, "Protokoll exportieren", os.path.join(start, name),
                                                    "Textdateien (*.txt);;Alle Dateien (*)")
            if not target:
                return ""
            err = audit.write_export(target, self._audit_rows, self._audit_period, self._audit_changes_only)
            return err or f"Gespeichert: {target}"

        @Slot()
        def showAudit(self):
            """Aus dem Menü am Symbol: Fenster zeigen und die Seite öffnen."""
            self.showRequested.emit()
            self.showAuditRequested.emit()

        def _set_state(self, state):
            if state != self._state:
                self._state = state
                self.stateChanged.emit()

        def _set_busy(self, value):
            if value != self._busy:
                self._busy = value
                self.busyChanged.emit()

        # ---- Lebenszeichen ---------------------------------------------------------
        @Slot()
        def poll(self):
            if self._poll_busy:
                return
            self._poll_busy = True
            self._reload_choice()
            settings = hc.gateway_settings()
            if settings != self._settings:
                self._settings = settings
                self._client = self._make_client()
            client = self._client

            def work():
                result = {"ok": False, "version": "", "key_usable": settings["key_usable"], "error": ""}
                try:
                    h = client.health()
                    result["ok"] = str(h.get("status", "")).lower() == "ok"
                    result["version"] = str(h.get("version") or "")
                except hc.GatewayError as exc:
                    result["error"] = str(exc)
                self._healthDone.emit(result)

            threading.Thread(target=work, name="hermes-health", daemon=True).start()

        def _on_health(self, result):
            self._poll_busy = False
            if result.get("version") and result["version"] != self._version:
                self._version = result["version"]
                self.versionChanged.emit()
            if not result.get("ok"):
                self._set_state("off")
                self._session_ready = False
                return
            if not result.get("key_usable"):
                self._set_state("nokey")
                return
            if self._approval:
                self._set_state("asking")
            elif self._busy:
                self._set_state("busy")
            else:
                self._set_state("ready")
            if not self._history_loaded:
                self._history_loaded = True
                self._load_history()

        # ---- Verlauf -------------------------------------------------------------
        def _load_history(self):
            client, sid = self._client, self._session_id

            def work():
                out = {"ok": False, "rows": [], "error": ""}
                try:
                    client.ensure_session(sid)
                    rows = []
                    for r in client.history(sid):
                        # Bilder aus dem Verlauf kommen als data-URLs; QML lädt die nicht,
                        # also als Datei in den Cache. http-Adressen bleiben, wie sie sind.
                        images = []
                        for url in r.get("images") or []:
                            if url.startswith("data:"):
                                path = store_data_url(url)
                                if path:
                                    images.append(file_url(make_preview(path)))
                            else:
                                images.append(url)
                        text = r["content"]
                        if r["role"] == "user" and "[screenshot]" in text:
                            # Hermes speichert Bildteile nur als Platzhalter (agent/session_persistence.py)
                            text = text.replace("[screenshot]", "(Bild mitgeschickt)")
                        rows.append({"role": r["role"], "text": text, "images": images,
                                     "time": format_time(r.get("timestamp"))})
                    out["rows"] = rows
                    out["ok"] = True
                except hc.GatewayError as exc:
                    out["error"] = str(exc)
                self._historyDone.emit(out)

            threading.Thread(target=work, name="hermes-history", daemon=True).start()

        def _on_history(self, out):
            if not out.get("ok"):
                self._history_loaded = False
                self._model.append("info", f"Verlauf nicht geladen: {out.get('error')}")
                return
            self._session_ready = True
            self._model.replace(out["rows"])
            if self._context:
                # Beim Start mit --discuss kommt der Verlauf erst nach dem Bericht
                self._show_context()

        @Slot()
        def newConversation(self):
            self._session_id = "hermes-os-tray-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
            self._save_session_id()
            self._session_ready = False
            self._model.clear()
            self.stateChanged.emit()
            self._history_loaded = True
            self._load_history()

        # ---- Kontext aus einer Benachrichtigung (Morgenbericht) -------------------
        def discuss(self, path):
            """„Im Chat besprechen": Fenster zeigen, den Bericht als Blase von Hermes in den
            Verlauf, und mit der nächsten Nachricht geht er als Kontext an Hermes."""
            context = hc.read_context_file(path)
            if not context:
                self._model.append("info", "Der Bericht zur Benachrichtigung ist nicht mehr da.")
            else:
                self._context = context
                self._show_context()
            self.showRequested.emit()

        def _show_context(self):
            self._model.append("assistant", self._context, when=now_hhmm())
            self._model.append("info", "Frag nach, was dich daran interessiert; der Bericht geht mit.")

        def discussAnswer(self, question, answer, image_paths):
            """Antwort aus einer Benachrichtigung („Was sehe ich hier?", tray/screenshot.py) ins
            Fenster holen: Frage mit Bild und Antwort als Blasen, das Bild als Anhang für die
            Nachfrage, die Antwort als Kontext der nächsten Nachricht."""
            paths = [p for p in image_paths if os.path.isfile(p)]
            self._model.append("user", question, images=[file_url(make_preview(p)) for p in paths], when=now_hhmm())
            self._model.append("assistant", answer, when=now_hhmm())
            self.attachFiles(paths)
            self._context = f"Frage zum Bildschirmausschnitt: {question}\n\nAntwort von Hermes: {answer}"
            self._model.append("info", "Frag nach, was dich daran interessiert; Ausschnitt und Antwort gehen mit.")
            self.showRequested.emit()

        # ---- Senden und Ereignisse ---------------------------------------------
        @Slot(str)
        def send(self, text):
            text = text.strip()
            attachments = list(self._attachments)
            if (not text and not attachments) or self._busy or self._state not in ("ready",):
                return
            self.clearAttachments()
            self._model.append("user", text, images=[a["url"] for a in attachments], when=now_hhmm())
            text = hc.with_context(self._context, text)
            self._context = ""
            self._assistant_row = -1
            self._open_tools = []
            self._set_busy(True)
            self._set_state("busy")
            client, sid = self._client, self._session_id

            def work():
                run_id = ""
                try:
                    # Verkleinern und Kodieren hier im Thread, damit das Fenster nicht hakt
                    images = [encode_image_for_upload(a["path"]) for a in attachments]
                    client.ensure_session(sid)
                    run_id = client.start_run(sid, text, images)
                    self._runEvent.emit("run.accepted", {"run_id": run_id})
                    for event in client.events(run_id):
                        self._runEvent.emit(str(event.get("event") or ""), event)
                    self._runEvent.emit("stream.closed", {"run_id": run_id})
                except (hc.GatewayError, ValueError, OSError) as exc:
                    self._runEvent.emit("client.error", {"run_id": run_id, "message": str(exc)})

            threading.Thread(target=work, name="hermes-run", daemon=True).start()

        def _assistant(self):
            if self._assistant_row < 0:
                self._assistant_row = self._model.append("assistant", "", when=now_hhmm())
            return self._assistant_row

        def _finish_answer(self, output):
            """Antwort abschließen: `output` des Abschlussereignisses ersetzt den gestreamten
            Text, MEDIA:<pfad>-Tags werden zu Bildern, eine leere Blase verschwindet."""
            row = self._assistant_row
            if isinstance(output, str) and output.strip():
                final = output
            elif row >= 0:
                final = self._model.text(row)
            else:
                return
            clean, paths = hc.split_media_tags(final)
            images = [file_url(make_preview(p)) for p in paths if os.path.isfile(p)]
            if not clean.strip() and not images:
                if row >= 0:
                    self._model.remove(row)
                    self._assistant_row = -1
                return
            row = self._assistant()
            if clean != self._model.text(row):
                self._model.set_text(row, clean)
            if images:
                self._model.set_images(row, images)

        def _on_run_event(self, name, event):
            if name == "run.accepted":
                self._run_id = str(event.get("run_id") or "")
            elif name == "message.delta":
                row = self._assistant()
                self._model.set_text(row, self._model.text(row) + str(event.get("delta") or ""))
            elif name == "tool.started":
                tool = str(event.get("tool") or "")
                preview = str(event.get("preview") or "").strip().splitlines()
                row = self._model.append("tool", f"{tool}: {preview[0][:160]}" if preview else tool, "started")
                self._open_tools.append((tool, row))
            elif name == "tool.completed":
                # Eine Zeile je Aufruf: die Startzeile desselben Werkzeugs bekommt Dauer
                # oder Fehler angehängt, statt dass eine zweite Zeile dazukommt
                tool = str(event.get("tool") or "")
                failed = bool(event.get("error"))
                mark = "Fehler" if failed else tool_duration(event.get("duration"))
                meta = "error" if failed else "completed"
                hit = next((i for i, (t, _) in enumerate(self._open_tools) if t == tool), None)
                if hit is None:
                    self._model.append("tool", f"{tool} · {mark}", meta)
                else:
                    _, row = self._open_tools.pop(hit)
                    self._model.set_text(row, f"{self._model.text(row)} · {mark}", meta)
            elif name == "approval.request":
                choices = [c for c in (event.get("choices") or ["once", "deny"]) if c in hc.APPROVAL_CHOICES]
                description = str(event.get("description") or "")
                self._approval = {
                    "request_id": str(event.get("request_id") or ""),
                    "command": hc.approval_command(event.get("command"), description),
                    "description": description,
                    "choices": choices,
                    "labels": [CHOICE_LABEL[c] for c in choices],
                }
                self.approvalChanged.emit()
                self._set_state("asking")
                self._notify_approval()
            elif name == "approval.responded":
                self._clear_approval()
            elif name in ("run.completed", "run.failed", "run.cancelled", "run.interrupted"):
                self._finish_answer(event.get("output"))
                final = self._model.text(self._assistant_row) if name == "run.completed" and self._assistant_row >= 0 else ""
                if name == "run.failed":
                    reason = str(event.get("turn_exit_reason") or event.get("error") or "unbekannt")
                    self._model.append("error", f"Hermes hat abgebrochen: {reason}")
                elif name != "run.completed":
                    self._model.append("info", "Abgebrochen.")
                self._finish()
                self.answerFinished.emit(final)
            elif name == "client.error":
                self._model.append("error", str(event.get("message") or "Fehler"))
                self._finish()
                self.answerFinished.emit("")
            elif name == "stream.closed":
                if self._busy:
                    self._finish()
                    self.answerFinished.emit("")

        def _finish(self):
            self._clear_approval()
            self._run_id = ""
            self._assistant_row = -1
            self._set_busy(False)
            if self._state in ("busy", "asking"):
                self._set_state("ready")
            QTimer.singleShot(0, self.poll)

        @Slot()
        def stopRun(self):
            client, run_id = self._client, self._run_id
            if not run_id:
                return

            def work():
                try:
                    client.stop(run_id)
                except hc.GatewayError as exc:
                    self._runEvent.emit("client.error", {"run_id": run_id, "message": str(exc)})

            threading.Thread(target=work, name="hermes-stop", daemon=True).start()

        # ---- Freigaben -----------------------------------------------------------
        @Slot(str)
        def approve(self, choice):
            if not self._approval or choice not in self._approval.get("choices", []):
                return
            client, run_id, request_id = self._client, self._run_id, self._approval.get("request_id", "")
            if audit is not None:
                # Das Plugin sieht die Wahl auch, aber nicht, dass sie hier fiel
                audit.record_tray_decision(self._approval.get("command", ""), choice, request_id,
                                           self._approval.get("description", ""))
            self._model.append("info", f"Freigabe: {CHOICE_LABEL.get(choice, choice)}")
            self._clear_approval()

            def work():
                try:
                    client.approve(run_id, choice, request_id)
                except hc.GatewayError as exc:
                    self._runEvent.emit("client.error", {"run_id": run_id, "message": f"Freigabe: {exc}"})

            threading.Thread(target=work, name="hermes-approve", daemon=True).start()

        def _clear_approval(self):
            if self._approval:
                self._approval = {}
                self.approvalChanged.emit()
            if self._state == "asking":
                self._set_state("busy" if self._busy else "ready")
            if self._notify_proc is not None:
                proc, self._notify_proc = self._notify_proc, None
                note_id = getattr(proc, "notify_id", "")
                if note_id.isdigit():
                    # Im Fenster oder vom Gateway beantwortet: sonst bliebe die Benachrichtigung
                    # stehen, denn notify-send zu beenden schließt sie nicht.
                    QProcess.startDetached("gdbus", ["call", "--session", "--dest", "org.freedesktop.Notifications",
                                                     "--object-path", "/org/freedesktop/Notifications",
                                                     "--method", "org.freedesktop.Notifications.CloseNotification",
                                                     note_id])
                proc.kill()

        def _notify_approval(self):
            """KDE-Benachrichtigung mit Knöpfen; notify-send nennt zuerst die ID (-p, damit
            _clear_approval sie schließen kann), wartet dann und schreibt die Wahl auf stdout."""
            if shutil.which("notify-send") is None or not self._approval:
                return
            a = self._approval
            args = ["-p", "-a", "hermes-os", "-i", "hermes-os-tray-asking", "-u", "critical",
                    "-t", str(approval_timeout_seconds() * 1000)]
            for c in a["choices"]:
                args += ["-A", f"{c}={CHOICE_LABEL[c]}"]
            body = a["command"]
            if a["description"]:
                body += "\n" + a["description"]
            proc = QProcess(self)
            proc.setProgram("notify-send")
            proc.setArguments(args + ["Hermes fragt nach einer Freigabe", body])
            proc.notify_id = ""

            def read_id():
                if not proc.notify_id and proc.canReadLine():
                    proc.notify_id = bytes(proc.readLine()).decode("utf-8", "replace").strip()

            def finished(code, status):
                read_id()
                lines = bytes(proc.readAllStandardOutput()).decode("utf-8", "replace").strip().splitlines()
                choice = lines[-1].strip() if lines else ""
                if self._notify_proc is proc:
                    self._notify_proc = None
                if choice in hc.APPROVAL_CHOICES and self._approval:
                    self.approve(choice)

            proc.readyReadStandardOutput.connect(read_id)
            proc.finished.connect(finished)
            self._notify_proc = proc
            proc.start()

        # ---- Sprünge nach draußen -----------------------------------------------
        def _konsole(self, *cmd):
            if QProcess.startDetached("konsole", ["-e", *cmd]):
                return
            QProcess.startDetached("xdg-terminal-exec", [*cmd])

        @Slot()
        def openSetup(self):
            QProcess.startDetached(SETUP, [])

        @Slot()
        def openDashboard(self):
            if self.dashboardAvailable:
                QProcess.startDetached(DASHBOARD, [])

        @Slot()
        def startGateway(self):
            # Der First-Login-Skript-Weg: legt den API-Schlüssel an, wenn er fehlt,
            # und schaltet das Gateway ein, sobald ein Anbieter eingerichtet ist.
            if os.path.isfile(FIRST_LOGIN):
                QProcess.startDetached(FIRST_LOGIN, [])
            else:
                QProcess.startDetached("systemctl", ["--user", "start", GATEWAY_UNIT])
            QTimer.singleShot(2000, self.poll)

        @Slot()
        def openTerminalChat(self):
            self._konsole(HERMES)

        @Slot()
        def hideWindow(self):
            self.hideRequested.emit()

        @Slot()
        def showWindow(self):
            self.showRequested.emit()

    # ---- Anwendung ---------------------------------------------------------------
    QQuickStyle.setStyle("org.kde.desktop")
    QApplication.setApplicationName("hermes-os-tray")
    QApplication.setDesktopFileName("hermes-os-tray")
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)
    app.setWindowIcon(QIcon.fromTheme("hermes-os", QIcon.fromTheme("dialog-messages")))

    backend = Backend()
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("backend", backend)
    # ---- Sehen und Hören (tray/screenshot.py, tray/voice.py, docs/sehen-hoeren.md) ----
    # Fenster und show_window entstehen erst nach engine.load; beide Module holen sie
    # sich über die Funktionen, wenn sie gebraucht werden.
    import screenshot
    import voice as voice_module
    look = screenshot.install(backend, lambda: window, lambda: show_window(), backend._make_client,
                              encode_image_for_upload, CACHE_DIR, hc.split_media_tags)
    voice = voice_module.install(backend, lambda: show_window(), CACHE_DIR)
    engine.rootContext().setContextProperty("look", look)
    engine.rootContext().setContextProperty("voice", voice)
    engine.load(MAIN_QML)
    if not engine.rootObjects():
        print(f"hermes-os-tray: {MAIN_QML} konnte nicht geladen werden", file=sys.stderr)
        return 1
    window = engine.rootObjects()[0]

    def show_window():
        window.show()
        window.raise_()
        window.requestActivate()

    def toggle_window():
        if window.isVisible():
            window.hide()
        else:
            show_window()

    backend.showRequested.connect(show_window)
    backend.hideRequested.connect(window.hide)

    def icon_for(state):
        name = voice.iconName or STATE_ICON.get(state, "hermes-os-tray-off")
        return QIcon.fromTheme(name, QIcon.fromTheme("dialog-messages"))

    tray = QSystemTrayIcon(icon_for(backend.state))
    menu = QMenu()
    act_open = menu.addAction("Hermes öffnen")
    act_open.triggered.connect(toggle_window)
    act_new = menu.addAction("Neues Gespräch")
    act_new.triggered.connect(backend.newConversation)
    # Modell und Denkaufwand: dieselbe Wahl wie der Knopf im Fenster, mit Haken am Stand
    menu_model = menu.addMenu("Modell")
    menu_effort = menu.addMenu("Denkaufwand")

    def fill_choice_menus():
        menu_model.clear()
        options = backend.modelOptions
        if options:
            for o in options:
                act = menu_model.addAction(o["label"])
                act.setCheckable(True)
                act.setChecked(bool(o["checked"]))
                act.triggered.connect(lambda _checked=False, m=o["id"]: backend.setModel(m))
        else:
            current = menu_model.addAction(backend.modelText.split(" · ")[0] if backend.modelAvailable else "kein Modell")
            current.setEnabled(False)
            menu_model.addAction("Anderes Modell: Hermes einrichten …").triggered.connect(backend.openSetup)
        menu_effort.clear()
        for e in backend.effortOptions:
            act = menu_effort.addAction(e["label"])
            act.setCheckable(True)
            act.setChecked(bool(e["checked"]))
            act.triggered.connect(lambda _checked=False, v=e["value"]: backend.setEffort(v))

    fill_choice_menus()
    backend.modelChanged.connect(fill_choice_menus)
    menu.aboutToShow.connect(backend.refreshModels)
    backend.refreshModels()     # einmal beim Start, damit der Knopf gleich den kurzen Namen zeigt
    menu.addSeparator()
    if backend.libraryAvailable:
        menu.addAction("Bibliothek").triggered.connect(backend.showLibrary)
    if backend.auditAvailable:
        menu.addAction("Protokoll").triggered.connect(backend.showAudit)
    if look.available:
        menu.addAction("Was sehe ich hier?").triggered.connect(lambda: look.start())
    if voice.available:
        menu.addAction("Mit Hermes sprechen").triggered.connect(voice.toggle)
    if backend.dashboardAvailable:
        menu.addAction("Dashboard öffnen").triggered.connect(backend.openDashboard)
    menu.addAction("Hermes einrichten").triggered.connect(backend.openSetup)
    act_gateway = menu.addAction("Gateway starten")
    act_gateway.triggered.connect(backend.startGateway)
    menu.addAction("Chat im Terminal").triggered.connect(backend.openTerminalChat)
    menu.addSeparator()
    menu.addAction("Beenden").triggered.connect(app.quit)
    tray.setContextMenu(menu)

    def refresh_tray():
        tray.setIcon(icon_for(backend.state))
        tip = voice.stateText or backend.stateText
        if backend.hermesVersion:
            tip += "\n" + backend.hermesVersion
        tray.setToolTip(tip)
        act_gateway.setEnabled(backend.state == "off")

    backend.stateChanged.connect(refresh_tray)
    backend.versionChanged.connect(refresh_tray)
    voice.stateChanged.connect(refresh_tray)
    app.aboutToQuit.connect(voice.shutdown)
    refresh_tray()

    def activated(reason):
        r = QSystemTrayIcon.ActivationReason
        if reason in (r.Trigger, r.DoubleClick, r.MiddleClick):
            toggle_window()

    tray.activated.connect(activated)
    tray.show()

    # ---- Befehle der zweiten Instanz -------------------------------------------
    server = QLocalServer()

    def incoming():
        conn = server.nextPendingConnection()
        if conn is None:
            return

        def read():
            data = bytes(conn.readAll())
            for line in data.splitlines():
                if line.startswith(b"discuss "):
                    backend.discuss(os.fsdecode(line[len(b"discuss "):].strip()))
                elif line.startswith(b"look"):
                    look.start(line[len(b"look"):].strip().decode("utf-8", "replace"))
                elif line.strip() == b"talk":
                    voice.toggle()
                elif line.strip() == b"show":
                    show_window()
            conn.disconnectFromServer()

        conn.readyRead.connect(read)

    server.newConnection.connect(incoming)
    if not server.listen(socket_name):
        print(f"hermes-os-tray: kein lokaler Socket ({server.errorString()}), Meta+H erreicht diese Instanz nicht",
              file=sys.stderr)

    # ---- KRunner: „hermes <Frage>“ (tray/runner.py) ------------------------------
    try:
        import runner
        krunner = runner.install(backend, show_window, window, backend._make_client, hc.split_media_tags)  # noqa: F841
    except Exception as exc:  # das Symbol läuft auch ohne KRunner
        print(f"hermes-os-tray: KRunner-Runner nicht geladen: {exc}", file=sys.stderr)

    if discuss_path:
        backend.discuss(discuss_path)
    elif want_look:
        QTimer.singleShot(300, lambda: look.start(look_question))
    elif want_talk:
        QTimer.singleShot(300, voice.toggle)
    elif want_show:
        show_window()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
