#!/usr/bin/env bash
# =============================================================================
# hermes-os -- Einrichtung pro Nutzer beim Login (idempotent)
# =============================================================================
# Läuft bei jedem Login über /etc/xdg/autostart, macht aber nur, was fehlt:
#   1. ~/.hermes anlegen, Config-Vorlage kopieren (nur wenn keine existiert)
#   2. Plugin und Skill aus /usr/share/hermes-os verlinken (Symlinks, damit
#      ein Image-Update sie automatisch aktualisiert)
#   3. Plugin aktivieren
#   4. Gateway-Dienst einschalten, sobald ein Provider konfiguriert ist;
#      vorher den Schlüssel für den lokalen API-Server des Gateways anlegen,
#      über den das Leisten-Symbol (hermes-os-tray) mit Hermes spricht
#   5. Beim allerersten Mal: Einrichtungsassistent öffnen (Kirigami-Fenster,
#      /usr/libexec/hermes-os-setup); ohne ihn ein Terminal mit `hermes setup`
# =============================================================================
set -euo pipefail

SHARE=/usr/share/hermes-os
HOME_DIR="${HOME:?}"
HERMES_HOME="${HERMES_HOME:-${HOME_DIR}/.hermes}"
export HERMES_HOME
LOG="${HERMES_HOME}/hermes-os-first-login.log"

mkdir -p "${HERMES_HOME}/plugins" "${HERMES_HOME}/skills"
exec >>"${LOG}" 2>&1
echo "=== $(date -Iseconds) ==="

# 1. Config-Vorlage
if [ ! -f "${HERMES_HOME}/config.yaml" ]; then
  cp "${SHARE}/config.yaml.default" "${HERMES_HOME}/config.yaml"
  echo "config.yaml aus Vorlage angelegt"
  FIRST_RUN=1
else
  FIRST_RUN=0
fi

# 2. Plugin und Skill verlinken
link() {  # link <ziel> <linkpfad>
  if [ -L "$2" ] || [ ! -e "$2" ]; then
    ln -sfn "$1" "$2"
  else
    echo "WARN: $2 existiert und ist kein Symlink, lasse es in Ruhe"
  fi
}
link "${SHARE}/plugins/hermes_os" "${HERMES_HOME}/plugins/hermes_os"
link "${SHARE}/skills/hermes-os-system" "${HERMES_HOME}/skills/hermes-os-system"

# 3. Plugin aktivieren. `hermes plugins enable` ist idempotent und schreibt
#    nur die enabled-Liste in config.yaml; ein Grep auf die Tabellenausgabe
#    von `plugins list` wäre fehleranfällig ("not enabled" enthält "enabled").
/usr/bin/hermes plugins enable hermes-os || echo "WARN: hermes plugins enable fehlgeschlagen"

# 4. Gateway einschalten, wenn ein Provider eingerichtet ist.
#    reenable statt enable: ältere Installationen hatten die Unit noch an
#    default.target hängen; reenable räumt den alten Symlink weg.
if [ -f "${HERMES_HOME}/.env" ] || [ -f "${HERMES_HOME}/auth.json" ]; then
  # 4a. API-Server des Gateways freischalten. Hermes startet ihn, sobald
  #     API_SERVER_KEY (mindestens 16 Zeichen) in .env steht; er lauscht nur
  #     auf 127.0.0.1:8642. Der Schlüssel ist ein Zufallswert je Nutzer und
  #     bleibt in .env (0600). Kam er neu dazu, während das Gateway schon
  #     lief, braucht das Gateway einen Neustart, sonst nur einen Start.
  ENV_FILE="${HERMES_HOME}/.env"
  API_ADDED=0
  if [ ! -f "${ENV_FILE}" ]; then
    (umask 077 && : > "${ENV_FILE}")
  fi
  if ! grep -qE '^(export )?API_SERVER_KEY=' "${ENV_FILE}"; then
    API_KEY="$(/usr/bin/python3 -c 'import secrets; print(secrets.token_hex(24))' 2>/dev/null \
               || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    printf '\n# hermes-os: lokaler API-Server des Gateways (nur 127.0.0.1) fuer das Leisten-Symbol\nAPI_SERVER_ENABLED=true\nAPI_SERVER_KEY=%s\n' "${API_KEY}" >> "${ENV_FILE}"
    API_ADDED=1
    echo "API_SERVER_KEY in .env angelegt"
  elif ! grep -qE '^(export )?API_SERVER_ENABLED=' "${ENV_FILE}"; then
    printf 'API_SERVER_ENABLED=true\n' >> "${ENV_FILE}"
    API_ADDED=1
  fi
  chmod 0600 "${ENV_FILE}" || true
  systemctl --user reenable hermes-gateway.service || echo "WARN: gateway reenable fehlgeschlagen"
  if [ "${API_ADDED}" = "1" ] && systemctl --user is-active --quiet hermes-gateway.service; then
    systemctl --user restart hermes-gateway.service || echo "WARN: gateway restart fehlgeschlagen"
  else
    systemctl --user start hermes-gateway.service || echo "WARN: gateway start fehlgeschlagen"
  fi
fi

# 5. Erster Start: Einrichtung anbieten. Der Assistent ist ein eigenes
#    Fenster; der Assistent selbst ruft dieses Skript nach dem Speichern
#    erneut auf, damit Schritt 4 das Gateway einschaltet. Fällt er aus
#    (PySide6 fehlt, QML kaputt), bleibt das Terminal mit `hermes setup`.
if [ "${FIRST_RUN}" = "1" ]; then
  if [ -x /usr/libexec/hermes-os-setup ] && /usr/libexec/hermes-os-setup --check >/dev/null 2>&1; then
    notify-send -a hermes-os "Hermes ist bereit zur Einrichtung" \
      "Ein Fenster führt durch Anbieter, Schlüssel und Modell. Später erreichbar über: Hermes einrichten im Menü oder ujust hermes-setup" || true
    setsid /usr/libexec/hermes-os-setup >/dev/null 2>&1 &
  else
    echo "WARN: hermes-os-setup nicht lauffähig, nehme Terminal"
    notify-send -a hermes-os "Hermes ist bereit zur Einrichtung" \
      "Ein Terminal öffnet sich mit 'hermes setup'. Dort Provider und Modell wählen. Sprache am Desktop danach mit: hermes, dann /voice on" || true
    if command -v konsole >/dev/null 2>&1; then
      setsid konsole -e /usr/bin/hermes setup >/dev/null 2>&1 &
    elif command -v xdg-terminal-exec >/dev/null 2>&1; then
      setsid xdg-terminal-exec /usr/bin/hermes setup >/dev/null 2>&1 &
    fi
  fi
fi
echo "done"
