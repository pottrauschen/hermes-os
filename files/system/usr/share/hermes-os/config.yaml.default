# =============================================================================
# hermes-os -- Vorgabe für ~/.hermes/config.yaml
# =============================================================================
# Wird beim ersten Login nach ~/.hermes/config.yaml kopiert, falls dort noch
# nichts liegt. Danach gehört die Datei dem Nutzer; ein Image-Update
# überschreibt sie nicht. Alle Schlüssel sind Hermes-Standardschlüssel
# (siehe cli-config.yaml.example im Hermes-Repo).
#
# Modell und Provider werden hier absichtlich NICHT gesetzt: `hermes setup`
# fragt danach beim ersten Start.
# =============================================================================

# ---- Undo für Projektdateien -------------------------------------------------
# Vor write_file/patch und vor erkennbar destruktiven Shell-Befehlen (rm, mv,
# cp, sed -i, >, git reset ...) ein Snapshot des betroffenen Projektordners
# im Shadow-Git-Store (~/.hermes/checkpoints), höchstens einmal pro Ordner
# und Modellschritt. /rollback im Chat holt ihn zurück. Nicht erfasst: /etc,
# Flatpak, bootc und andere Systemänderungen.
checkpoints:
  enabled: true
  max_snapshots: 30
  max_total_size_mb: 1000

# ---- Die Grenze: frei oder fragen -------------------------------------------
# mode smart: Hermes' Detektor erkennt gefährliche Muster (rm -r, Schreiben
# nach /etc, systemctl stop/mask ...) und lässt den Guardian-LLM entscheiden;
# smart_policy ergänzt dessen Regeln. Befehle, die der Detektor nicht kennt
# (bootc, rpm-ostree, ujust update, systemctl start/enable, Nutzer, Disks),
# schickt der pre_tool_call-Hook des hermes-os-Plugins direkt in den
# Freigabe-Dialog. Neustart/Herunterfahren sind für den Agenten gesperrt.
approvals:
  mode: smart
  timeout: 300
  cron_mode: deny
  single_query_mode: deny
  unattended_mode: deny
  denial_breaker_threshold: 3
  smart_policy: |
    hermes-os Regeln. ESCALATE (Nutzer fragen) bei allem, was das laufende
    System berührt: bootc upgrade/rollback/switch, rpm-ostree install/override,
    systemctl ohne --user (start/stop/enable/disable/mask), Änderungen unter
    /etc, /usr, /boot, Kernel-Argumente, firewall-cmd, sudo, Nutzer- und
    Passwortverwaltung, ssh-keygen/authorized_keys, Formatieren, Partitionen,
    rm/mv außerhalb des aktuellen Projekts oder mit Wildcards auf Home-Ebene.
    APPROVE ohne Rückfrage: Befehle im Home des Nutzers und im aktuellen
    Projekt, flatpak install/update/remove, distrobox/podman, systemctl --user,
    lesende Befehle (status, list, show, cat, grep, journalctl).

# ---- Terminal --------------------------------------------------------------
# Phase 1: lokale Shell auf dem Host, weil der Agent das System bedienen soll.
# Für Projektarbeit später: Docker/Podman-Backend pro Projekt.
terminal:
  backend: local
  timeout: 180

# ---- Sprache -----------------------------------------------------------------
# Spracherkennung lokal (faster-whisper), Deutsch als Vorgabe.
stt:
  enabled: true
  provider: local
  language: de
  local:
    model: small

# Sprachausgabe lokal (Piper). Die Stimme wird beim ersten Gebrauch geladen.
tts:
  provider: piper
  piper:
    voice: de_DE-thorsten-medium

# ---- Anzeige -----------------------------------------------------------------
display:
  interface: cli

# ---- Fremde Anmeldungen ------------------------------------------------------
# Hermes würde sonst eine Anmeldung von Claude Code (~/.claude/.credentials.json)
# oder der Codex-CLI (~/.codex/auth.json) von selbst übernehmen, sobald es
# keinen eigenen Login hat. Für Claude ist das nicht erlaubt: Anthropic
# gestattet das Abo nur in den eigenen Programmen, nicht in einem fremden
# Agenten (docs/einrichtung.md, Abschnitt Abo). Hermes nutzt hier nur, was
# der Nutzer ausdrücklich einträgt.
auth:
  adopt_external_logins: false
